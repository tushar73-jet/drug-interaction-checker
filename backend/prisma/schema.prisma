// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model DrugInteraction {
  id          Int    @id @default(autoincrement())
  drug1       String
  drug2       String
  description String
  severity    String // E.g., Major, Moderate, Minor

  @@index([drug1])
  @@index([drug2])
}

model PatientProfile {
  id        String   @id @default(uuid())
  clerkId   String
  name      String
  drugs     String   // Store as JSON stringified array for SQLite compatibility
  notes     String?  // Optional clinician notes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clerkId])
}

model SearchHistory {
  id           String   @id @default(uuid())
  clerkId      String
  drugsChecked String   // Comma-separated or JSON list of drugs involved in the check
  resultCount  Int
  createdAt    DateTime @default(now())

  @@index([clerkId])
}
