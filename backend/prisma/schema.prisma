generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Drug {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  class       String?
  mechanism   String?
  interactionsAsDrug1 DrugInteraction[] @relation("Drug1Relation")
  interactionsAsDrug2 DrugInteraction[] @relation("Drug2Relation")
}

model DrugInteraction {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  drug1Id     String @db.ObjectId
  drug2Id     String @db.ObjectId
  description String
  severity    String // Major, Moderate, Minor
  
  drug1       Drug   @relation("Drug1Relation", fields: [drug1Id], references: [id])
  drug2       Drug   @relation("Drug2Relation", fields: [drug2Id], references: [id])

  @@unique([drug1Id, drug2Id])
}

model PatientProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  clerkId   String
  name      String
  notes     String?
  drugs     ProfileDrug[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clerkId])
}

model ProfileDrug {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  profileId String   @db.ObjectId
  drugName  String
  profile   PatientProfile @relation(fields: [profileId], references: [id])

  @@index([profileId])
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  clerkId   String?
  action    String   
  resource  String   
  payload   Json?
  ipAddress String?
  timestamp DateTime @default(now())

  @@index([clerkId])
  @@index([timestamp])
}


